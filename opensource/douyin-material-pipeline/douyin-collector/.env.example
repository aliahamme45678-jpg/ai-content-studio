# 抖音素材库流水线 · 环境变量模板
# 复制成 .env 再填值。.env 已被 .gitignore 挡住，不会提交。

# ===== 必填 =====

# 阿里云百炼 DashScope API Key
# 用途：① 口播文案转写（Paraformer）② 评论蒸馏与需求归并（qwen-turbo / qwen-plus）
DASHSCOPE_API_KEY=

# ===== 采集行为（2026-10-17 抖音风控绕过，建议原样保留）=====

# 游客模式：不加载 douyin_state.json。
# 原因：登录态被风控降权后，带 cookie 反而被 302 到 /jingxuan、detail 返回 200 但 body 为空；
# 不带 cookie（游客）反而能拿到完整数据。详见 SKILL.md 坑 33。
DOUYIN_NO_STATE=1

# 强制用内置 Chromium（不用系统 Edge）。
# 实测矩阵：只有「Chromium + 游客」能拿到 detail 数据，Edge 两条路都不行。
DOUYIN_BROWSER=chromium

# ===== 音频提取技能包位置（一般不用填）=====

# audio_step.py 会自动按这个顺序找 douyin-url-to-16k-wav/scripts：
#   ① 本变量 ② 仓库同级目录 ③ 仓库内子目录 ④ ~/.workbuddy-ai/skills/ 下
# 放在别处时才需要填。
# DOUYIN_WAV_SCRIPTS=

# ===== 已废弃（仅兼容保留，不用填）=====

# 酷虎云（口播文案已改走阿里云百炼，这个通道停用了）
# 注意：曾经有一份 key 被硬编码在 collector.py 里，2026-10-17 已清除。
# KUHUYUN_API_KEY=
